{
  "name": "@escrcpy/flow-cli",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Command line for flow devices, recording, compiling and replaying",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "flow": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "*",
    "@escrcpy/adbx": "workspace:*",
    "@escrcpy/flow-core": "workspace:*",
    "@escrcpy/flow-device": "workspace:*",
    "@escrcpy/flow-mcp": "workspace:*",
    "yaml": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "*",
    "typescript": "*",
    "vitest": "5.0.5"
  }
}
