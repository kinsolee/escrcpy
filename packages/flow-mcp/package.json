{
  "name": "@escrcpy/flow-mcp",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing flow-device tools with a built-in trace recorder (M1)",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "flow-mcp": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "*",
    "@escrcpy/adbx": "workspace:*",
    "@escrcpy/flow-core": "workspace:*",
    "@escrcpy/flow-device": "workspace:*",
    "@escrcpy/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "*",
    "typescript": "*",
    "vitest": "5.0.5"
  }
}
